# Copy to .env and set a unique, private dashboard key before starting Compose.
REVENUE_DASHBOARD_KEY=replace-with-a-long-random-secret
API_PORT=8080

# Set the public HTTPS origin before creating hosted payment invoices.
PAYMENTS_PUBLIC_BASE_URL=
# OxaPay merchant API key, or NOWPayments API key plus its separate IPN secret.
TOOLPIPE_ADMIN_KEY=
OXAPAY_MERCHANT_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Legacy direct-wallet settings are not used by checkout.
EVM_WALLET_ADDRESS=
SOLANA_WALLET=
